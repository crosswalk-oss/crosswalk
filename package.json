{
  "name": "crosswalk",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts_postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sample:sap": "UPDATE_SAP_SAMPLE=1 vitest run src/core/engine/reconcile.test.ts",
    "licenses": "node scripts/check-licenses.mjs",
    "notices": "node scripts/notices.mjs",
    "audit": "npm audit --omit dev --audit-level=high",
    "copilot-txt": "node scripts/copilot-txt.mjs",
    "serve:local": "vite-node scripts/local-server.ts",
    "migrate": "node scripts/migrate.mjs",
    "deploy": "npm run build && node scripts/embed-page.mjs && neon deploy --env .env.local",
    "embed": "node scripts/embed-page.mjs"
  },
  "dependencies": {
    "@neon/functions": "^0.11.0",
    "@neondatabase/serverless": "^1.0.2",
    "esri-leaflet": "^3.0.12",
    "immer": "^10.1.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@neon/config": "^1.9.2",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "description": "Open-source capital project delivery for gas utilities: stage gates, estimating, forecasting, SAP actuals, risk and workflow. Demo uses fictional data only."
}
